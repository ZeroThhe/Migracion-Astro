---
import '../styles/index.css';
import App from '../react/App.jsx';
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>FACC Music — Tienda de Vinilos, CDs y Álbumes de Colección</title>

    <!-- Google Fonts: tipografía de poster (Playfair Display, Syne, Caveat, Plus Jakarta Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#180D09] text-amber-50 selection:bg-amber-400 selection:text-slate-900 min-h-screen overflow-x-hidden">
    <App client:load />
    <!-- Portal Root para el Modal de Producto (React Portales) -->
    <div id="modal-portal"></div>
  </body>
</html>
